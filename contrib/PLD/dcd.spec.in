# $Revision: 1.39 $, $Date: 2007/03/01 13:53:43 $
Summary:	DConnect Daemon - Hub D****ct Connect for Linux
Summary(pl):	DConnect Daemon - Hub D****ct Connecta dla Linuksa
Name:		@PACKAGE_NAME@
Version:	@PACKAGE_VERSION@
Release:	1
License:	GPL v2
Group:		Networking/Daemons
Vendor:		DConnect Team <dc-hub@ds.pg.gda.pl>
Source0:	ftp://pollux.ds.pg.gda.pl/Linux/DConnect/sources/stable/%{name}-%{version}.tar.gz
URL:		http://www.dc.ds.pg.gda.pl/
BuildRequires:	cmake
BuildRequires:	openssl-devel
Requires:	libcrypto
BuildRoot:	%{tmpdir}/%{name}-%{version}-root-%(id -u -n)

%description
This is Linux D*** Connect Hub implementation for Linux. It works in
daemon mode and utilizes threads.

%description -l pl
Pakiet zawiera Linuksow± implementacjê huba D*** Connecta, który 
pracuje jako demon i u¿ywa w±tków.

%prep
%setup -q

%build
%{__cmake} \
	-DCMAKE_BUILD_TYPE=Release \
	-DDCD_CONFIG_DIR=%{_sysconfdir}/@PACKAGE_NAME@ \
	-DDEFAULT_GROUP=daemon \
	-DDEFAULT_USER=daemon \
	.

%{__make}

%install
rm -rf $RPM_BUILD_ROOT
#install -d $RPM_BUILD_ROOT{/etc/{sysconfig,rc.d/init.d,logrotate.d},/var/log/archiv/@PACKAGE_NAME@}
install -d $RPM_BUILD_ROOT{/etc/{sysconfig,rc.d/init.d,logrotate.d}}

%{__make} install \
	DESTDIR=$RPM_BUILD_ROOT

install contrib/PLD/@PACKAGE_NAME@.init $RPM_BUILD_ROOT/etc/rc.d/init.d/@PACKAGE_NAME@
install contrib/@PACKAGE_NAME@.sysconfig $RPM_BUILD_ROOT/etc/sysconfig/@PACKAGE_NAME@
install contrib/logrotate.@PACKAGE_NAME@ $RPM_BUILD_ROOT/etc/logrotate.d/@PACKAGE_NAME@

#touch $RPM_BUILD_ROOT@LOG_DIR@/@PACKAGE_NAME@.log

%clean
rm -rf $RPM_BUILD_ROOT

%post
/sbin/chkconfig --add @PACKAGE_NAME@
if [ -f /var/lock/subsys/@PACKAGE_NAME@ ]; then
        /etc/rc.d/init.d/@PACKAGE_NAME@ restart 1>&2
else
        echo "Run \"/etc/rc.d/init.d/@PACKAGE_NAME@ start\" to start DConnect Daemon."
fi

%preun
if [ "$1" = "0" ]; then
        if [ -f /var/lock/subsys/@PACKAGE_NAME@ ]; then
                /etc/rc.d/init.d/@PACKAGE_NAME@ stop 1>&2
        fi
        /sbin/chkconfig --del @PACKAGE_NAME@
fi

%triggerpreun -- dcd < 0.1.1
echo "Upgrading from version < 0.1.1"
echo "Remember to review config - the options were changed!!!"
if [ -e /etc/dcd/dchub.conf ]; then
	cp @CONFIGDIR@/@PACKAGE_NAME@.conf @CONFIGDIR@/@PACKAGE_NAME@.conf.new
	cp @CONFIGDIR@/dchub.conf @CONFIGDIR@/@PACKAGE_NAME@.conf
fi

%triggerpostun -- dcd < 0.3.5
echo "Upgrading from version < 0.3.5"
if [ -e /etc/dcd/console.users.rpmsave ]; then
	cp /etc/dcd/dcd.users /etc/dcd/dcd.users.rpmnew
	cp /etc/dcd/console.users.rpmsave /etc/dcd/dcd.users
fi
echo "Remember to review config - console users has been changed into dcd.users"
cp /etc/dcd/dcd.conf /etc/dcd/dcd.conf.rpmsave
sed -e s/console.users/dcd.users/g /etc/dcd/dcd.conf >/etc/dcd/dcd.conf.tmp
mv -f /etc/dcd/dcd.conf.tmp /etc/dcd/dcd.conf

%files
%defattr(644,root,root,755)
%doc AUTHORS BUGS FAQ NEWS README TODO USERCOMMANDS SYSLOG
%attr(755,root,root) %{_sbindir}/@PACKAGE_NAME@
%attr(755,root,root) /etc/rc.d/init.d/@PACKAGE_NAME@
%attr(770,@DEFAULT_USER@,@DEFAULT_GROUP@) %config(noreplace) %{_sysconfdir}/@PACKAGE_NAME@
%attr(660,@DEFAULT_USER@,@DEFAULT_GROUP@) %config(noreplace) %{_sysconfdir}/@PACKAGE_NAME@/*
%attr(644,root,root) %config(noreplace) /etc/sysconfig/@PACKAGE_NAME@
%attr(644,root,root) %config(noreplace) /etc/logrotate.d/@PACKAGE_NAME@
#%attr(644,daemon,root) @LOG_DIR@/@PACKAGE_NAME@.log
#%attr(755,daemon,root) %dir @LOG_DIR@
#%dir /var/log/archiv/@PACKAGE_NAME@
%{_mandir}/man1/*.1*
%{_mandir}/man2/*.2*

%define date    %(echo `LC_ALL="C" date +"%a %b %d %Y"`)
%changelog
* %{date} DConnect Daemon <dc-hub@ds.pg.gda.pl>

